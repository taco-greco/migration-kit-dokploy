# Copy to templates/authentik/.env before deploying.
# CRITICAL: If you are migrating an EXISTING authentik instance, AUTHENTIK_SECRET_KEY
# must be the exact same value as the old install (find it in the old .env / Dokploy
# env vars). It's used to sign sessions and encrypt some stored data — a new random
# key means restored users can't log in and some data is unreadable. Generate a new
# one ONLY for a brand-new install with `openssl rand -base64 36`.
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_DB=authentik
AUTHENTIK_PG_PASS=change-me
