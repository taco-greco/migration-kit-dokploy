# ============================================================================
# migration-kit target configuration
# Copy this file to ".env" and fill in values for the machine you're
# targeting. This is the ONLY file that should change between running the
# kit against the test mini PC (step 2) and the real Dell R630 (step 3).
# Never commit the real .env (it holds secrets) — only .env.example.
# ============================================================================

# --- Target host -------------------------------------------------------
# IP address of the box Dokploy is being installed on / apps deployed to.
TARGET_IP=192.168.1.50

# Set to "true" once the network admin has given this host a fixed/reserved
# IP (DHCP reservation or static). Scripts will warn if this is "false".
TARGET_IP_IS_STATIC=false

# --- Domain / SSL (used mainly in step 3, the real server) -------------
# Internal-only base domain, e.g. apps.devopsmedia.internal or a real
# subdomain you own that just isn't publicly routable (e.g. int.yourdomain.com)
BASE_DOMAIN=devopsmedia.internal

# Leave empty during step 2 testing. In step 3 set to your DNS provider's
# API token if using DNS-01 challenge for Let's Encrypt on a private domain
# that has no public A record (see runbook section "Domain & SSL").
DNS_PROVIDER=
DNS_API_TOKEN=

# Comma-separated list of subdomains this kit will wire up, one per app.
# Dokploy will create a Traefik route + (in step 3) a cert for each.
AUTHENTIK_HOST=auth.${BASE_DOMAIN}
GLPI_HOST=glpi.${BASE_DOMAIN}
NEXTCLOUD_HOST=cloud.${BASE_DOMAIN}

# --- Dokploy -------------------------------------------------------------
# Pin a version once step 2 is validated, so step 3 installs the exact same
# thing instead of "whatever is latest that day". Leave empty for latest.
DOKPLOY_VERSION=

# --- Backup destination ---------------------------------------------------
# Where backup-app.sh / restore-app.sh copy data during the migration.
# For step 2 -> step 3 (same LAN) plain SSH/rsync is simplest, no S3 needed.
BACKUP_METHOD=rsync            # rsync | s3
BACKUP_SSH_TARGET=              # e.g. user@192.168.1.60:/srv/migration-backups
BACKUP_LOCAL_DIR=./backups      # used when BACKUP_METHOD=rsync and staging locally first

# Only needed if you later turn on Dokploy's built-in scheduled Volume
# Backups (S3-only, see runbook). Not required for the one-time migration.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
